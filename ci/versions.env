# Source de vérité des versions d'outillage (lue par la CI et les scripts).
# Éditeur Godot ET export templates DOIVENT avoir exactement la même version.
# Vérifiez la dernière 4.x stable sur https://godotengine.org/download/archive/

GODOT_VERSION=4.7.2

# À FIGER sur un tag précis de https://github.com/MikeSchulze/gdUnit4/tags
# (compatible avec GODOT_VERSION). "master" est accepté mais non reproductible.
GDUNIT4_REF=master

# Android : à ALIGNER sur la page "Exporting for Android" de la doc Godot
# correspondant à GODOT_VERSION (build-tools, plateforme, NDK, CMake).
ANDROID_BUILD_TOOLS=35.0.1
ANDROID_PLATFORM=android-35
ANDROID_NDK=28.1.13356709
ANDROID_CMAKE=3.10.2.4988404

# Nom du projet Xcode généré par l'export iOS (build/ios/<nom>.xcodeproj)
IOS_PROJECT_NAME=MonJeu
